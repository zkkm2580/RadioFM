<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_radio"
        android:contentDescription="Radio Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电台名称"
            android:textColor="@color/item_name_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_channel_frequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="FM 106.1"
            android:textColor="@color/item_sub_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_channel_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="国家台"
        android:background="@color/item_category_bg"
        android:textColor="@color/item_category_text"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textSize="11sp" />

</LinearLayout>
